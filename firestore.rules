rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is root admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.matches('(?i)admin@gmail\\.com') ||
        request.auth.token.email.matches('(?i)ladaderahul@gmail\\.com') ||
        request.auth.token.email.matches('(?i)admin@.*')
      );
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Movies collection - real-time synced across all users
    match /movies/{movieId} {
      allow read: if true;
      allow write: if true;
    }

    // Subscription Plans
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ads Config
    match /ads/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Feedbacks
    match /feedbacks/{feedbackId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // Push Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System Connection Test
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}
